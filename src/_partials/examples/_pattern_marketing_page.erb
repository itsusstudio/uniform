<%# locals: (id:, live:, banner:) -%>
<%= render "examples/site_header", id: id, live: live, banner: banner %>
<section class="py-6 sm:py-12">
<div class="u-container">
  <div class="flex flex-col gap-6">
    <h2 class="text-hero font-headline">One price for the whole shop</h2>
    <div class="u-grid">
      <div class="@grid:col-span-6 flex flex-col gap-6">
        <p class="text-lead"><span class="u-data">$39</span> a month for everyone at the counter and the bench. Try it for 14 days before you add a card.</p>
        <div class="u-actions"><a class="u-btn u-btn-primary u-btn-lg" href="#example">Start free trial</a></div>
      </div>
    </div>
  </div>
</div>
</section>
