<%
  span_value = defined?(span) && span
  loading_value = defined?(loading) && loading
  prefix_value = (defined?(prefix) && prefix) || ""
  uid = ->(name) { [prefix_value, name].reject(&:empty?).join("-") }
  weeks = ["Aug 17", "Aug 24", "Aug 31", "Sep 7", "Sep 14", "Sep 21", "Sep 28", "Oct 5", "Oct 12", "Oct 19", "Oct 26", "Nov 2"]
  counts = [14, 17, 12, 19, 21, 18, 16, 22, 20, 24, 19, 23]
  chart_json = ->(data) { raw(JSON.generate(data).gsub("</", "<\\/")) }
-%>
<section class="u-card<%= " u-span-#{span_value}" if span_value %>">
  <header>
    <h2>Jobs finished</h2>
    <form id="<%= uid.("weekly-period") %>" action="/reports" method="get">
      <fieldset class="u-fieldset">
        <legend class="u-visually-hidden">Period</legend>
        <div class="u-toggle-group">
          <label><input type="radio" name="weeks" value="12" checked> 12 weeks</label>
          <label><input type="radio" name="weeks" value="26"> 26 weeks</label>
        </div>
      </fieldset>
    </form>
  </header>
  <div class="u-card-content">
<% if loading_value -%>
    <div class="u-stat" aria-hidden="true">
      <p><span class="u-shimmer">23</span></p>
      <p><span class="u-shimmer">Last week, up 4</span></p>
    </div>
    <u-chart type="bar" height="160" aria-busy="true" data-label="Jobs finished each week"></u-chart>
<% else -%>
    <div class="u-stat">
      <p>23</p>
      <p data-trend="up">Last week, up 4 on the week before</p>
    </div>
    <u-chart type="bar" height="160" data-label="Jobs finished each week">
      <script type="application/json"><%= chart_json.(rows: weeks.zip(counts).map { |week, count| {label: week, values: [count]} }) %></script>
    </u-chart>
<% end -%>
    <p class="u-chart-footer"><span>Updated just now</span><a href="/reports/jobs">Full report</a></p>
  </div>
</section>
