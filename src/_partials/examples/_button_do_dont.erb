<div class="examples u-grid gap-6">
<figure class="example @grid:col-span-6">
<p class="example-verdict example-verdict-dont">Don’t</p>
<div class="example-frame"><div class="u-actions"><span class="u-btn u-btn-primary">Save job</span><span class="u-btn u-btn-primary">Print ticket</span><span class="u-btn u-btn-primary">Text customer</span></div></div>
<figcaption class="example-caption example-caption-dont"><span>Three primary buttons in a row, so nothing tells you which one matters.</span></figcaption>
</figure>
<figure class="example @grid:col-span-6">
<p class="example-verdict example-verdict-do">Do</p>
<div class="example-frame"><div class="u-actions"><span class="u-btn u-btn-primary">Save job</span><span class="u-btn u-btn-outline">Print ticket</span><span class="u-btn u-btn-ghost">Text customer</span></div></div>
<figcaption class="example-caption example-caption-do"><span>One primary action, the rest outline or ghost.</span></figcaption>
</figure>
</div>
