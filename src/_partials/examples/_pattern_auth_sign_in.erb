<%# locals: (id:, tag:) -%>
<div class="u-auth-shell">
  <header>
    <a class="u-wordmark u-wordmark-lg u-wordmark-serif" href="/">Workbench</a>
    <p class="u-text-article-title">Every repair, from the counter to pickup.</p>
  </header>
  <<%= tag %>>
    <h1 class="u-text-page-title">Sign in</h1>
    <form class="u-form" action="/sign-in" method="post">
      <div class="u-field">
        <label for="<%= id %>-email">Email address</label>
        <input class="u-input" id="<%= id %>-email" name="email_address" type="email" autocomplete="username" autocapitalize="off" spellcheck="false" required placeholder=" ">
      </div>
      <button type="submit" class="u-btn u-btn-primary">Send code</button>
    </form>
    <p class="u-text-small">Don’t have an account? <a href="/sign-up">Sign up</a></p>
  </<%= tag %>>
  <footer>
    <p><a href="/terms">Terms</a>&nbsp;&nbsp;<a href="/privacy">Privacy</a></p>
  </footer>
</div>
