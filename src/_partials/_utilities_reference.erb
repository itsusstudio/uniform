<%
  sample = lambda do |entry|
    name = entry.name
    case name
    when "u-wordmark" then %(<a class="u-wordmark u-wordmark-serif" href="#utilities">Workbench</a>)
    when "u-data" then %(<p class="u-data">#1042 · 3 items · $85.00</p>)
    when "text-hero", "text-section-title" then %(<p class="#{name} font-headline">One price</p>)
    when "text-article-title" then %(<p class="#{name} font-headline">Ring resize, size 6 to 7</p>)
    else %(<p class="#{name}">Ring resize, size 6 to 7</p>)
    end.html_safe
  end
-%>
<% site.data.classes.select { |entry| entry.page == "/start/reference/" }.group_by(&:group).each do |group, entries| -%>
<h3 id="utilities-<%= group.downcase %>"><%= group %></h3>

<dl>
<% entries.each do |entry| -%>
<dt id="<%= entry.name.split(/, | to /).first.delete("<>") %>"><%= code_names(entry.name) %></dt>
<dd>
<p><%= inline_markdown(entry.description) %><% if entry["scope"] == "sites" %> <span class="u-badge u-badge-info u-badge-strong">Sites only</span><% end %></p>
<div class="reference-example flex flex-col gap-2"><%= sample.(entry) %></div>
</dd>
<% end -%>
</dl>
<% end -%>
