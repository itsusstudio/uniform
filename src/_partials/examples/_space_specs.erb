<div class="spec-list">
<% rows.each do |row| %>
<div class="spec-row">
<div class="spec-meta"><u-copy><button type="button" class="u-link-btn u-data" data-copy="gap-<%= row[:px] / 4 %>" data-copied="Copied" data-copy-failed="Couldn’t copy">gap-<%= row[:px] / 4 %></button></u-copy><span><%= row[:px] / 4 %> × 4px = <%= row[:px] %>px</span></div>
<div class="space-row">
<span class="space-sample" style="width: calc(var(--spacing) * <%= row[:px] / 4 %>)"></span>
<div class="flex flex-col gap-2">
<p class="text-body"><%= row[:job] %></p>
<ul class="list-disc pl-4 text-small">
<% row[:uses].each do |use| %><li><%= inline_markdown(use) %></li><% end %>
</ul>
<p class="text-small text-muted">In component CSS: <code class="u-data">--spacing(<%= row[:px] / 4 %>)</code></p>
</div>
</div>
</div>
<% end %>
</div>
