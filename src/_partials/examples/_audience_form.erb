<form class="u-form audience-example" action="#audience">
  <div class="u-field">
    <label for="audience-name">Customer name</label>
    <input class="u-input" id="audience-name" name="name" autocomplete="name" placeholder=" ">
  </div>
  <div class="u-field">
    <label for="audience-email">Email address</label>
    <input class="u-input" id="audience-email" type="email" name="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder=" " value="dana@kensingtonrepair.ca">
  </div>
  <div class="u-field">
    <label for="audience-type">Repair type</label>
    <select class="u-input" id="audience-type" name="type">
      <option>Battery replacement</option>
      <option>Clasp replacement</option>
      <option selected>Ring resize</option>
    </select>
  </div>
  <div class="u-field">
    <label for="audience-quote">Quote</label>
    <div class="u-input-prefixed">
      <span>$</span>
      <input class="u-input u-data" id="audience-quote" name="quote" inputmode="decimal" autocomplete="off" value="85.00" aria-describedby="audience-quote-hint" placeholder=" ">
    </div>
    <small id="audience-quote-hint">Before tax.</small>
  </div>
  <div class="u-actions">
    <button type="submit" class="u-btn u-btn-primary">Save job</button>
    <button type="button" class="u-btn u-btn-outline">Cancel</button>
  </div>
</form>
