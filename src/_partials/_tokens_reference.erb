<%
  tokens = uniform_tokens
  light = tokens[:theme].merge(tokens[:root])
  dark = tokens[:dark]
  # Each light-dark(a, b) in a value resolves to a for the Light column and b for the Dark one.
  pick = ->(value, side) do
    out = +""
    rest = value
    while (start = rest.index("light-dark("))
      out << rest[0...start]
      depth = 0
      args = [+""]
      i = start + "light-dark(".length
      while i < rest.length
        char = rest[i]
        if char == "(" then depth += 1
        elsif char == ")"
          break if depth.zero?
          depth -= 1
        elsif char == "," && depth.zero?
          args << +""
          i += 1
          next
        end
        args.last << char
        i += 1
      end
      out << args[side].strip
      rest = rest[(i + 1)..]
    end
    out << rest
  end
  dark = light.select { |_, value| value.include?("light-dark(") }.transform_values { |value| pick.(value, 1) }.merge(dark)
  light = light.transform_values { |value| pick.(value, 0) }
  business = tokens[:theme].merge(tokens[:root]).slice(*tokens[:consumer].keys)
  consumer = tokens[:consumer]
  sizes = ["--spacing-target", "--spacing-control", "--spacing-field", "--spacing-row"]
  token_groups = [
    ["Colour", "/foundations/colour/", ->(n) { n.start_with?("--background-color-", "--text-color-", "--border-color-", "--color-") }],
    ["Font", "/foundations/typography/", ->(n) { n.start_with?("--font-") }],
    ["Type", "/foundations/typography/", ->(n) { n.start_with?("--text-", "--leading-") && !n.start_with?("--text-color-") }],
    ["Space", "/foundations/space-and-layout/", ->(n) { n.start_with?("--spacing") && !sizes.include?(n) }],
    ["Width", "/foundations/space-and-layout/", ->(n) { n.start_with?("--container-") }],
    ["Size", "/foundations/space-and-layout/", ->(n) { sizes.include?(n) }],
    ["Radius", "/foundations/shape-and-depth/", ->(n) { n.start_with?("--radius-") }],
    ["Shadow", "/foundations/shape-and-depth/", ->(n) { n.start_with?("--shadow-") }],
    ["Motion", "/foundations/motion/", ->(n) { n.start_with?("--u-duration-", "--ease-") }],
    ["Chart", "/foundations/charts/", ->(n) { n.start_with?("--u-chart-") }],
    ["Component", "/start/reference/", ->(n) { n.start_with?("--u-shimmer-", "--u-icon-") }]
  ]
  grouped = token_groups.map(&:last)
  token_groups << ["Other", "/start/reference/", ->(n) { grouped.none? { |test| test.(n) } }]
-%>
<% token_groups.each do |label, foundation, matches| -%>
<% names = light.keys.select(&matches) -%>
<% next if names.empty? -%>
<h3 id="tokens-<%= label.downcase.tr(" ", "-") %>"><%= label %></h3>

<p>When to use them: <a href="<%= foundation %>"><%= site.data.navigation.flat_map { |group| group.items.to_a }.find { |item| item.url == foundation }&.title %></a>.</p>

<div class="u-table" tabindex="0" role="region" aria-labelledby="tokens-<%= label.downcase.tr(" ", "-") %>">
<table class="reference-tokens">
<thead><tr><th scope="col">Token</th><th scope="col">Light</th><th scope="col">Dark</th></tr></thead>
<tbody>
<% names.each do |name| -%>
<tr>
<%= render "token_name", token: name %>
<td><span class="flex flex-wrap items-center gap-2"><% if label == "Colour" || name.include?("-color-") || name.end_with?("-color") %><span class="reference-swatch" style="background: <%= light[name] %>"></span><% elsif label == "Space" %><span class="reference-bar" style="width: <%= light[name] %>"></span><% end %><code class="u-data"><%= light[name] %></code></span></td>
<td><% if dark[name] %><span class="flex flex-wrap items-center gap-2"><% if label == "Colour" || name.include?("-color-") || name.end_with?("-color") %><span class="reference-swatch" style="background: <%= dark[name] %>"></span><% end %><code class="u-data"><%= dark[name] %></code></span><% end %></td>
</tr>
<% end -%>
</tbody>
</table>
</div>
<% end -%>
<h3 id="tokens-audience">Audience</h3>

<p>Set by <code>data-u-audience</code> on the html element. When to use them: <a href="/start/audience/">Audience</a>.</p>

<div class="u-table" tabindex="0" role="region" aria-labelledby="tokens-audience">
<table class="reference-tokens">
<thead><tr><th scope="col">Token</th><th scope="col">Business</th><th scope="col">Consumer</th></tr></thead>
<tbody>
<% business.each_key do |name| -%>
<tr>
<%= render "token_name", token: name %>
<td><code class="u-data"><%= business[name] %></code></td>
<td><code class="u-data"><%= consumer[name] %></code></td>
</tr>
<% end -%>
</tbody>
</table>
</div>
