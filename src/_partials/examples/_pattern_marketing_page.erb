<%# locals: (id:, live:, banner:) -%>
<%= render "examples/site_header", id: id, live: live, banner: banner %>
<section class="u-section">
<div class="u-container">
  <div class="u-stack u-gap-6">
    <h2 class="u-text-hero">One price for the whole shop</h2>
    <div class="u-grid">
      <div class="u-span-6 u-stack">
        <p class="u-text-lead"><span class="u-text-data">$39</span> a month for everyone at the counter and the bench. Try it for 14 days before you add a card.</p>
        <div class="u-actions"><a class="u-btn u-btn-primary u-btn-lg" href="#example">Start free trial</a></div>
      </div>
    </div>
  </div>
</div>
</section>
