<% dont_shell = capture do %>
<div class="u-app-shell">
<header>
<span class="u-wordmark u-wordmark-serif">Workbench</span>
<div class="u-actions">
<button type="button" class="u-btn u-btn-primary"><%= inline_partial("icon", name: "plus", small: true) %>New job</button>
<button type="button" class="u-btn u-btn-ghost"><%= inline_partial("icon", name: "menu", small: true) %>Menu</button>
</div>
</header>
<main>
<div class="u-container">
<header class="u-page-header">
<hgroup>
<h3>Jobs</h3>
<p><span class="u-data">38</span> open, <span class="u-data">6</span> due this week</p>
</hgroup>
</header>
</div>
</main>
</div>
<% end %>
<% do_shell = capture do %>
<div class="u-app-shell">
<header>
<span class="u-wordmark u-wordmark-serif">Workbench</span>
<button type="button" class="u-btn u-btn-ghost">Menu</button>
</header>
<main>
<div class="u-container">
<header class="u-page-header">
<hgroup>
<h3>Jobs</h3>
<p><span class="u-data">38</span> open, <span class="u-data">6</span> due this week</p>
</hgroup>
<div class="u-actions">
<button type="button" class="u-btn u-btn-primary"><%= inline_partial("icon", name: "plus", small: true) %>New job</button>
</div>
</header>
</div>
</main>
</div>
<% end %>
<div class="examples u-grid gap-6">
<figure class="example @grid:col-span-6">
<p class="example-verdict example-verdict-dont">Don’t</p>
<div class="frame frame-phone" style="height: 260px">
<%= render "screen", title: "New job in the bar", html: dont_shell %>
</div>
<figcaption class="example-caption example-caption-dont"><span>New job moved up into the bar. Now the bar changes from page to page, and the page header has lost the one action it was for.</span></figcaption>
</figure>
<figure class="example @grid:col-span-6">
<p class="example-verdict example-verdict-do">Do</p>
<div class="frame frame-phone" style="height: 260px">
<%= render "screen", title: "New job in the page header", html: do_shell %>
</div>
<figcaption class="example-caption example-caption-do"><span>The bar holds the app name and Menu, the same on every page. New job stays in the page header, where it sits on a computer too.</span></figcaption>
</figure>
</div>
