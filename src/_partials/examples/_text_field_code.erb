<%# locals: (id:) -%>
<% value_text = defined?(value) && value -%>
<% error_text = defined?(error) && error -%>
<div class="u-field">
  <label for="<%= id %>">Code</label>
  <u-input-code>
    <input class="u-input" id="<%= id %>" name="code"<% if value_text %> value="<%= value_text %>"<% end %> inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" <% if error_text %> aria-invalid="true" aria-describedby="<%= id %>-error"<% end %> maxlength="6" required placeholder=" ">
  </u-input-code>
<% if error_text -%>
  <p class="u-error" id="<%= id %>-error"><%= error_text %></p>
<% end -%>
</div>
