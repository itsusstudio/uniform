<%# locals: (phone:) -%>
<% scope = phone ? "phone" : "desktop" -%>
<div class="u-container flex flex-col gap-12">
  <header class="u-page-header">
    <hgroup>
      <h1>Reports</h1>
      <p>November so far, to Thursday, <span class="u-data">Nov 12</span></p>
    </hgroup>
  </header>
  <div class="flex flex-col gap-6">
    <%= raw render("examples/pattern_charts_figures", prefix: scope).strip.gsub("\n", "\n    ") %>
<% if phone -%>
    <%= raw render("examples/chart_line", prefix: scope).strip.gsub("\n", "\n    ") %>
    <%= raw render("examples/chart_meter").strip.gsub("\n", "\n    ") %>
    <%= raw render("examples/chart_bar", prefix: scope).strip.gsub("\n", "\n    ") %>
    <%= raw render("examples/chart_stacked").strip.gsub("\n", "\n    ") %>
<% else -%>
    <div class="u-grid gap-6">
      <%= raw render("examples/chart_line", span: 8, prefix: scope).strip.gsub("\n", "\n      ") %>
      <div class="@grid:col-span-4 flex flex-col gap-6">
        <%= raw render("examples/chart_meter").strip.gsub("\n", "\n        ") %>
        <%= raw render("examples/chart_stacked").strip.gsub("\n", "\n        ") %>
      </div>
      <%= raw render("examples/chart_bar", span: 12, prefix: scope).strip.gsub("\n", "\n      ") %>
    </div>
<% end -%>
  </div>
</div>
