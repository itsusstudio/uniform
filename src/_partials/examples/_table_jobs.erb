<div class="flex flex-col gap-4">
  <search class="u-table-controls">
    <form action="#example" method="get">
      <div class="u-input-prefixed">
        <input autocomplete="off" class="u-input" type="search" autocorrect="off" autocapitalize="off" spellcheck="false" name="q" aria-label="Search jobs" placeholder="Name, job number or phone" value="ana">
      </div>
      <%= inline_partial("examples/table_presets", id: "table-presets", suffix: "#example", indent: 6) %>
      <%= inline_partial("examples/table_filter", id: "table-filter", selected: { "due" => "month" }, clear: "?q=ana&amp;sort=due&amp;dir=asc#example", indent: 6) %>
    </form>
    <ul aria-label="Filters">
      <li class="u-chip">Search: “ana”<a href="?due=month&amp;sort=due&amp;dir=asc#example" aria-label="Remove filter: Search: ana"></a></li>
      <li class="u-chip">Due this month<a href="?sort=due&amp;dir=asc#example" aria-label="Remove filter: Due this month"></a></li>
      <li><a class="u-btn u-btn-ghost" href="?sort=due&amp;dir=asc#example">Clear all</a></li>
    </ul>
  </search>
  <section class="u-card" aria-label="Jobs">
    <div class="u-table" tabindex="0" role="region" aria-label="Jobs">
      <table>
        <thead>
          <tr>
            <th scope="col">Job</th>
            <th scope="col">Customer</th>
            <th scope="col">Work</th>
            <th scope="col">Status</th>
            <th scope="col" aria-sort="ascending"><a class="u-table-sort" href="?due=month&amp;sort=due&amp;dir=desc#example">Due</a></th>
            <th scope="col" class="u-table-num"><a class="u-table-sort" href="?due=month&amp;sort=quote&amp;dir=asc#example">Quote</a></th>
          </tr>
        </thead>
        <tbody>
          <tr><td><a class="u-data" href="#example">#1042</a></td><td><mark>Ana</mark> Reyes</td><td>Ring resize</td><td><span class="u-badge u-badge-info">On the bench</span></td><td class="u-data">Nov 14</td><td class="u-table-num">$85.00</td></tr>
          <tr><td><a class="u-data" href="#example">#1051</a></td><td><mark>Ana</mark> Reyes</td><td>New crown and full service</td><td><span class="u-badge u-badge-warning">Quote to approve</span></td><td class="u-data">Nov 20</td><td class="u-table-num">$140.00</td></tr>
        </tbody>
      </table>
    </div>
  </section>
  <p class="u-meta">2 jobs</p>
</div>
