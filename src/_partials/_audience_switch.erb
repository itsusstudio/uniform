<% switch_legend_hidden = defined?(legend_hidden) && legend_hidden -%>
<% switch_legend_class = (defined?(legend_class) && legend_class) || "u-text-small u-text-muted" -%>
<form class="u-row">
<fieldset class="u-fieldset">
<legend class="<%= switch_legend_hidden ? "u-visually-hidden" : switch_legend_class %>">Audience</legend>
<div class="u-toggle-group">
<label><input type="radio" name="site-audience" value="business" checked> Business</label>
<label><input type="radio" name="site-audience" value="consumer"> Consumer</label>
</div>
</fieldset>
</form>
