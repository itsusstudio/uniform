<%# locals: (id:, live:) -%>
<div class="u-app-shell">
  <header>
    <a class="u-wordmark u-wordmark-serif" href="/" data-monogram="W">Workbench</a>
    <button type="button" class="u-btn u-btn-ghost"<% if live %> popovertarget="<%= id %>-nav"<% end %>>Menu</button>
  </header>
  <%= raw render("examples/app_shell_nav", id: "#{id}-nav", popover: true, current: "jobs").strip.gsub("\n", "\n  ") %>
  <main>
    <%= raw render("examples/pattern_timeline_page", prefix: id).strip.gsub("\n", "\n    ") %>
  </main>
</div>
