<%# locals: (id:, popover:) -%>
<div class="u-menu"<% if popover %> id="<%= id %>" popover<% end %>>
<a href="#example">Edit job</a>
<button type="button"<% if popover %> popovertarget="<%= id %>" popovertargetaction="hide"<% end %>>Change due date</button>
<button type="button"<% if popover %> popovertarget="<%= id %>" popovertargetaction="hide"<% end %>>Print ticket</button>
<hr>
<button type="button"<% if popover %> popovertarget="<%= id %>" popovertargetaction="hide"<% end %>>Text Ana Reyes</button>
<button type="button"<% if popover %> popovertarget="<%= id %>" popovertargetaction="hide"<% end %>>Copy status link</button>
<hr>
<button type="button" class="u-menu-item-danger"<% if popover %> popovertarget="<%= id %>" popovertargetaction="hide"<% end %>>Delete job</button>
</div>
