<%# locals: (id:, popover:) -%>
<dialog class="u-popover" id="<%= id %>" <% if popover %>popover<% else %>open<% end %> aria-label="Change due date">
<form>
<div class="u-field">
<label for="<%= id %>-date">Due date</label>
<input autocomplete="off" class="u-input" type="date" id="<%= id %>-date" name="due_on" value="2026-11-14"<% if popover %> autofocus<% end %>>
<small>Job <span class="u-data">#1042</span>, Ana Reyes</small>
</div>
<div class="u-actions">
<button type="button" class="u-btn u-btn-ghost"<% if popover %> popovertarget="<%= id %>" popovertargetaction="hide"<% end %>>Cancel</button>
<button type="button" class="u-btn u-btn-primary"<% if popover %> popovertarget="<%= id %>" popovertargetaction="hide"<% end %>>Save due date</button>
</div>
</form>
</dialog>
