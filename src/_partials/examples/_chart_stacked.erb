<% span_value = defined?(span) && span -%>
<% loading_value = defined?(loading) && loading -%>
<% statuses = [["danger", "Overdue", 2], ["info", "On the bench", 9], ["warning", "Waiting", 6], ["success", "Ready for pickup", 4]] -%>
<% chart_json = ->(data) { raw(JSON.generate(data).gsub("</", "<\\/")) } -%>
<section class="u-card <%= grid_span(span_value) %>">
  <header>
    <h2>Open jobs by status</h2>
    <a class="text-small" href="/jobs">All open jobs</a>
  </header>
  <div class="u-card-content">
<% if loading_value -%>
    <div class="u-stat" aria-hidden="true">
      <p><span class="u-shimmer">12</span></p>
      <p><span class="u-shimmer">Open now, down 2</span></p>
    </div>
    <u-chart type="stacked" aria-busy="true" data-label="Open jobs by status"></u-chart>
<% else -%>
    <div class="u-stat">
      <p><%= statuses.sum { |_, _, count| count } %></p>
      <p data-trend="down">Open now, down 2 on last Thursday</p>
    </div>
    <u-chart type="stacked" data-label="Open jobs by status">
      <script type="application/json"><%= chart_json.(rows: statuses.map { |tone, label, count| {label: label, values: [count], tone: tone} }) %></script>
    </u-chart>
<% end -%>
  </div>
</section>
