<%# locals: (prefix:, code:, sheet_open:) -%>
<%
  icon = ->(name, small = true) { code ? %(<svg class="u-icon#{" u-icon-sm" if small}" aria-hidden="true">…</svg>) : render("icon", name: name, small: small) }
  href = ->(path) { code ? path : "#example" }
  uid = ->(name) { [prefix, name].reject(&:empty?).join("-") }
  jobs = [
    ["1050", "Mateo Silva", "Overdue", "2026-11-10", "30.00"],
    ["1036", "Priya Shah", "Overdue", "2026-11-11", "25.00"],
    ["1041", "Grace Kim", "On the bench", "2026-11-12", "55.00"],
    ["1043", "Owen Gallagher", "Ready for pickup", "2026-11-13", "35.00"],
    ["1052", "Ruth Abara", "On the bench", "2026-11-13", "40.00"],
    ["1042", "Ana Reyes", "On the bench", "2026-11-14", "85.00"],
    ["1039", "Marcus Lee", "Waiting on parts", "2026-11-15", "40.00"],
    ["1046", "Fatima Noor", "On the bench", "2026-11-16", "45.00"],
    ["1049", "Claire Dubois", "Not started", "2026-11-17", "60.00"],
    ["1044", "Joanne Tremblay", "Ready for pickup", "2026-11-18", "120.00"],
    ["1045", "Hiro Tanaka", "Waiting on parts", "2026-11-19", "65.00"],
    ["1053", "Ben Kowalski", "Not started", "2026-11-19", "25.00"],
    ["1051", "Ana Reyes", "Quote to approve", "2026-11-20", "140.00"],
    ["1047", "Sam Okafor", "Not started", "2026-11-22", "310.00"],
    ["1048", "Lina Haddad", "On the bench", "2026-11-25", "95.00"]
  ]
  variants = { "Not started" => "neutral", "On the bench" => "info", "Waiting on parts" => "warning", "Quote to approve" => "warning", "Overdue" => "danger", "Ready for pickup" => "success" }
  shown = ["On the bench", "Waiting on parts", "Overdue"]
  dues = [["", "Any time"], ["overdue", "Past due"], ["week", "This week"], ["next", "Next week"], ["later", "Later"]]
  sorts = [["due", "Due date, soonest first"], ["-due", "Due date, latest first"], ["customer", "Customer, A to Z"], ["-quote", "Quote, highest first"]]
  short_date = ->(iso) { Date.parse(iso).strftime("%b %-d") }
  sheet = uid.("jobs-sheet")
-%>
<div class="u-stack u-gap-6">
  <header class="u-page-header">
    <hgroup>
      <h1>Jobs</h1>
      <p><span class="u-text-data">38</span> open, <span class="u-text-data">6</span> due this week</p>
    </hgroup>
    <div class="u-actions">
      <a class="u-btn u-btn-primary" href="<%= href.("/jobs/new") %>"><%= raw icon.("plus") %>New job</a>
    </div>
  </header>
  <div class="u-stack u-gap-4">
    <div data-grid-part="toolbar">
      <div class="u-stack u-gap-2">
        <search>
          <form action="/jobs" method="get">
            <label class="u-visually-hidden" for="<%= uid.("jobs-q") %>">Search jobs</label>
            <div class="u-input-prefixed">
              <input class="u-input" id="<%= uid.("jobs-q") %>" type="search" autocorrect="off" autocapitalize="off" spellcheck="false" name="q" placeholder="Name, job number or phone">
            </div>
          </form>
        </search>
        <div class="u-actions">
          <button type="button" class="u-btn u-btn-outline" commandfor="<%= sheet %>" command="show-modal"><%= raw icon.("sliders-horizontal") %>Sort and filter</button>
          <button type="button" class="u-btn u-btn-ghost" data-select-start>Select</button>
        </div>
      </div>
    </div>
    <div data-grid-part="bulk" hidden>
      <form class="u-row" action="/jobs/bulk" method="post" aria-label="Selected jobs">
        <span><output data-grid-count>0</output> selected</span>
        <button type="submit" class="u-btn u-btn-primary" name="bulk_action" value="ready">Mark ready</button>
        <button type="button" class="u-btn u-btn-ghost" data-select-done>Done</button>
      </form>
    </div>
    <div data-grid-part="chips">
      <div class="u-row" role="group" aria-label="Filters">
<% shown.each do |status| -%>
        <span class="u-chip">Status: <%= status %><button type="button" data-remove="status" value="<%= status %>" aria-label="Remove filter: Status: <%= status %>"></button></span>
<% end -%>
        <button type="button" class="u-btn u-btn-ghost" data-clear-filters>Clear all</button>
      </div>
    </div>
    <u-data-grid>
      <section class="u-card" aria-label="Jobs">
        <div class="u-table" tabindex="0" role="region" aria-label="Jobs">
          <table>
            <thead>
              <tr>
                <th scope="col">Job</th>
                <th scope="col" data-keep-narrow>Customer</th>
                <th scope="col" data-keep-narrow>Status</th>
                <th scope="col" data-keep-narrow>Due</th>
                <th scope="col" class="u-table-num" data-keep-narrow>Quote</th>
              </tr>
            </thead>
            <tbody>
<% jobs.each do |number, customer, status, due, quote| -%>
              <tr data-job="<%= number %>" data-customer="<%= customer %>" data-status="<%= status %>" data-due="<%= due %>" data-quote="<%= quote %>"<% unless shown.include?(status) %> hidden<% end %>>
                <th scope="row"><label class="u-checkbox" hidden><input type="checkbox" name="job_ids[]" value="<%= number %>"><span class="u-visually-hidden">Select job #<%= number %></span></label><a class="u-text-data" href="<%= href.("/jobs/#{number}") %>">#<%= number %></a></th>
                <td><%= customer %></td>
                <td><span class="u-badge u-badge-<%= variants[status] %>"><%= status %></span></td>
                <td class="u-text-data"><%= short_date.(due) %></td>
                <td class="u-table-num">$<%= quote %></td>
              </tr>
<% end -%>
            </tbody>
          </table>
        </div>
      </section>
    </u-data-grid>
    <nav class="u-pagination" aria-label="Pages">
      <a aria-disabled="true" aria-label="Previous page"></a>
      <span data-grid-range>1–9 of 9</span>
      <a href="<%= href.("/jobs?page=2") %>" rel="next" aria-label="Next page" aria-disabled="true" data-grid-next></a>
    </nav>
  </div>
</div>
<dialog class="u-dialog u-dialog-sheet" id="<%= sheet %>" aria-labelledby="<%= uid.("jobs-sheet-title") %>"<% if sheet_open %> open<% end %>>
  <form method="dialog">
    <header>
      <h2 id="<%= uid.("jobs-sheet-title") %>">Sort and filter</h2>
      <button type="submit" class="u-btn-close" value="cancel" formnovalidate aria-label="Close"></button>
    </header>
    <div class="u-card-content">
      <div class="u-field">
        <label for="<%= uid.("jobs-sort") %>">Sort by</label>
        <select class="u-input" id="<%= uid.("jobs-sort") %>" name="sort">
<% sorts.each do |value, label| -%>
          <option value="<%= value %>"><%= label %></option>
<% end -%>
        </select>
      </div>
      <fieldset class="u-fieldset">
        <legend>Status</legend>
<% variants.each_key do |status| -%>
        <label class="u-checkbox"><input type="checkbox" name="status[]" value="<%= status %>"<% if shown.include?(status) %> checked<% end %>><span><%= status %></span></label>
<% end -%>
      </fieldset>
      <fieldset class="u-fieldset">
        <legend>Due</legend>
<% dues.each do |value, label| -%>
        <label class="u-radio"><input type="radio" name="due" value="<%= value %>"<% if value.empty? %> checked<% end %>><span><%= label %></span></label>
<% end -%>
      </fieldset>
    </div>
    <div class="u-actions">
      <button type="button" class="u-btn u-btn-ghost" data-clear-filters>Clear all</button>
      <button type="submit" class="u-btn u-btn-primary" value="apply">Apply filters</button>
    </div>
  </form>
</dialog>
