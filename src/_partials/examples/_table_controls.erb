<search class="u-table-controls">
  <form action="#example" method="get">
    <div class="u-input-prefixed">
      <input autocomplete="off" class="u-input" type="search" autocorrect="off" autocapitalize="off" spellcheck="false" name="q" aria-label="Search jobs" placeholder="Name, job number or phone" value="ana">
    </div>
    <%= inline_partial("examples/table_presets", id: ((defined?(presets_id) && presets_id) || "controls-presets"), current: "Custom view", suffix: "#example", indent: 4) %>
    <%= inline_partial("examples/table_filter", id: ((defined?(filter_id) && filter_id) || "controls-filter"), selected: { "status" => "on_bench" }, clear: "?q=ana&amp;sort=due&amp;dir=asc#example", indent: 4) %>
  </form>
  <ul aria-label="Filters">
    <li class="u-chip">Search: “ana”<a href="?status=on_bench&amp;sort=due&amp;dir=asc#example" aria-label="Remove filter: Search: ana"></a></li>
    <li class="u-chip">Status: On the bench<a href="?sort=due&amp;dir=asc#example" aria-label="Remove filter: Status: On the bench"></a></li>
    <li><a class="u-btn u-btn-ghost" href="?sort=due&amp;dir=asc#example">Clear all</a></li>
  </ul>
</search>
