<div class="spec-list">
<% [
  ["u-btn u-btn-primary", '<button type="button" class="u-btn u-btn-primary">Save job</button>', "Primary. The one main action in a part of the page."],
  ["u-btn u-btn-outline", '<button type="button" class="u-btn u-btn-outline">Cancel</button>', "Outline. Every other action next to the primary one."],
  ["u-btn u-btn-ghost", '<button type="button" class="u-btn u-btn-ghost">Show more</button>', "Ghost. Quiet actions repeated many times, like in table rows."],
  ["u-btn u-btn-danger", '<button type="button" class="u-btn u-btn-danger">Delete job</button>', "Danger. An action that destroys something. Usually asks first."],
  ["u-btn-icon", nil, "Icon only. Add to any variant for a 36px square with one icon and an aria-label."],
  ["disabled", '<button type="button" class="u-btn u-btn-primary" disabled>Save job</button>', "Disabled. Use sparingly, and say nearby why it can't be pressed yet."],
].each do |cls, html, job| %>
<% html = html&.html_safe %>
<div class="spec-row">
<div class="spec-meta"><u-copy><button type="button" class="u-link-btn u-data" data-copy="<%= cls %>" data-copied="Copied" data-copy-failed="Couldn’t copy"><%= cls %></button></u-copy></div>
<div class="flex flex-wrap items-center gap-6 button-row">
<span class="button-sample"><% if html %><%= html %><% else %><button type="button" class="u-btn u-btn-ghost u-btn-icon" aria-label="More actions"><%= render "icon", name: "ellipsis", small: false %></button><button type="button" class="u-btn u-btn-outline u-btn-icon" aria-label="Add"><%= render "icon", name: "plus", small: false %></button><% end %></span>
<p class="text-body"><%= job %></p>
</div>
</div>
<% end %>
</div>
