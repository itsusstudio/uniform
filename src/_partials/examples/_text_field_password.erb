<%# locals: (id:, label:, autocomplete:) -%>
<div class="u-field">
  <label for="<%= id %>"><%= label %></label>
  <u-input-password>
    <input class="u-input" id="<%= id %>" type="password" name="password" autocomplete="<%= autocomplete %>" required placeholder=" ">
    <button type="button" aria-label="Show password" aria-pressed="false" aria-controls="<%= id %>" hidden></button>
  </u-input-password>
</div>
