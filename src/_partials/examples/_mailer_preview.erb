<%# locals: (slug:, title:, preheader:, sender:, reason:, address:, unsubscribe_url: nil, body: nil, plain_text: false) -%>
<%
  given = local_variables
  unsubscribe = given.include?(:unsubscribe_url) ? unsubscribe_url : nil
  override = given.include?(:body) ? body : nil
  ext = given.include?(:plain_text) && plain_text ? "txt" : "html"
  dir = Studio::Uniform.mailers_path.to_s
  fill = ->(value) { ext == "html" ? Erubi.h(value.to_s) : value.to_s }
  content = (override || File.read(File.join(dir, "#{slug}.#{ext}"))).to_s.strip
  email = File.read(File.join(dir, "layout.#{ext}"))
  on_behalf = sender != "Workbench"
  email = email.gsub(/^[ \t]*\{\{ if sent_with \}\}\n(.*?)^[ \t]*\{\{ end \}\}\n/m) { on_behalf ? $1 : "" }
  email = email.gsub(/^[ \t]*\{\{ if unsubscribe_url \}\}\n(.*?)^[ \t]*\{\{ end \}\}\n/m) { unsubscribe ? $1 : "" }
  email = email.gsub(/^[ \t]*\{\{ if terms_url \}\}\n(.*?)^[ \t]*\{\{ end \}\}\n/m) { on_behalf ? "" : $1 }
  lines = address.split(", ")
  site = sender == "Workbench" ? "https://useworkbench.example" : "https://kensingtonrepair.example"
  values = { "title" => title, "preheader" => preheader, "sender" => sender, "address_name" => lines[0], "address_street" => lines[1], "address_city" => lines[2..].to_a.join(", "), "terms_url" => "#{site}/terms", "privacy_url" => "#{site}/privacy", "unsubscribe_url" => unsubscribe, "sent_with" => "Workbench", "sent_with_url" => "https://useworkbench.co" }
  email = email.gsub(/\{\{ (\w+) \}\}/) { $1 == "content" ? content : fill.(values.fetch($1)) }
-%>
<%= raw email %>
