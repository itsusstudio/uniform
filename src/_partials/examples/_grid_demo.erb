<figure class="example">
<div class="example-frame example-tagged">
<span class="example-tag">Grid</span>
<div class="u-stack u-gap-4 grid-demo">
<p class="u-text-small u-text-muted grid-demo-parent">Each row is a <code class="u-text-data">u-grid</code>.</p>
<div class="u-grid grid-demo-columns" aria-hidden="true"><% 12.times do %><span></span><% end %></div>
<div class="u-grid"><div class="u-span-4"><code class="u-text-data">u-span-4</code></div><div class="u-span-4"><code class="u-text-data">u-span-4</code></div><div class="u-span-4"><code class="u-text-data">u-span-4</code></div></div>
<div class="u-grid"><div class="u-span-6"><code class="u-text-data">u-span-6</code></div><div class="u-span-6"><code class="u-text-data">u-span-6</code></div></div>
<div class="u-grid"><div class="u-span-4"><code class="u-text-data">u-span-4</code></div><div class="u-span-8"><code class="u-text-data">u-span-8</code></div></div>
<div class="u-grid"><div class="u-span-3"><code class="u-text-data">u-span-3</code></div><div class="u-span-9"><code class="u-text-data">u-span-9</code></div></div>
<div class="u-grid"><div>No class, spans all 12</div></div>
</div>
</div>
<figcaption class="example-caption"><span>Twelve columns with a 24px gutter, 16 on phones. Everything starts on a column line. On phones every child spans all twelve.</span></figcaption>
</figure>
