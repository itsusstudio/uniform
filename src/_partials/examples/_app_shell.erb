<%# locals: (id:, live:, tabs: false) -%>
<% tabs_on = defined?(tabs) && tabs -%>
<div class="u-app-shell">
  <header>
    <a class="u-wordmark u-wordmark-serif" href="/" data-monogram="W">Workbench</a>
    <button type="button" class="u-btn u-btn-ghost"<% if live %> popovertarget="<%= id %>-nav"<% end %>>Menu</button>
  </header>
  <%= raw render("examples/app_shell_nav", id: "#{id}-nav", popover: true).strip.gsub("\n", "\n  ") %>
  <main>
    <div class="u-container">
      <header class="u-page-header">
        <hgroup>
          <h1>Jobs</h1>
          <p><span class="u-text-data">38</span> open, <span class="u-text-data">6</span> due this week</p>
        </hgroup>
        <div class="u-actions">
          <a class="u-btn u-btn-primary" href="/jobs/new"><%= raw render("icon", name: "plus", small: true).strip %>New job</a>
        </div>
      </header>
    </div>
  </main>
<% if tabs_on -%>
  <nav aria-label="Workbench">
<% [["/", "house", "Home"], ["/jobs", "wrench", "Jobs"], ["/customers", "users", "Customers"], ["/payments", "credit-card", "Payments"]].each do |href, icon_name, label| -%>
    <a href="<%= href %>"<% if label == "Jobs" %> aria-current="page"<% end %>><%= raw render("icon", name: icon_name, small: false).strip %><span><%= label %></span></a>
<% end -%>
  </nav>
<% end -%>
</div>
