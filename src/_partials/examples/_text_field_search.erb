<%# locals: (code: false) -%>
<% code_value = defined?(code) && code -%>
<search>
  <form action="<%= code_value ? "/jobs" : "/components/text-field/" %>" method="get">
    <div class="u-field">
      <label for="jobs-search">Search jobs</label>
      <div class="u-input-prefixed">
        <input autocomplete="off" class="u-input" id="jobs-search" type="search" autocorrect="off" autocapitalize="off" spellcheck="false" name="q" placeholder="Name, job number or phone" enterkeyhint="search">
      </div>
    </div>
  </form>
</search>
