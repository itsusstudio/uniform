<u-character-count data-count="{count} of {max}">
  <div class="u-field">
    <label for="bench-notes">Notes for the bench <span>(optional)</span></label>
    <textarea class="u-input" id="bench-notes" name="notes" rows="2" maxlength="500" aria-describedby="bench-notes-count">Size 6 to 7. Customer wants the engraving kept.</textarea>
    <small id="bench-notes-count">Up to 500 characters</small>
  </div>
</u-character-count>
