<%# locals: (slug:, title:, preheader:, sender:, reason:, address:, unsubscribe_url: nil, plain_text: false) -%>
<%
  given = local_variables
  format = given.include?(:plain_text) && plain_text ? "text" : "html"
  u = Studio::Uniform::Mail.for(format)
  labels = YAML.load_file(Studio::Uniform.root.join("config/locales/uniform.en.yml")).dig("en", "uniform", "mail").transform_keys(&:to_sym)
  on_behalf = sender != "Workbench"
  site = on_behalf ? "https://kensingtonrepair.example" : "https://useworkbench.example"
  content = render("mailers/#{slug.tr("-", "_")}", format: format)
  email = u.layout(content,
    title: title, preheader: preheader, sender: sender, address: address.split(", ", 3), labels: labels,
    terms_url: (on_behalf ? nil : "#{site}/terms"), privacy_url: "#{site}/privacy",
    unsubscribe_url: (given.include?(:unsubscribe_url) ? unsubscribe_url : nil),
    sent_with: (on_behalf ? "Workbench" : nil), sent_with_url: "https://useworkbench.co",
    fonts: Studio::Uniform::Mail::FONTS.to_h { |_, _, file| [file, asset_path("uniform/assets/uniform/fonts/#{file}")] })
-%>
<%= raw email %>
