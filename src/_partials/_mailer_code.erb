<%# locals: (slug:) -%>
<%
  open = "<" + "%"
  close = "%" + ">"
  source = File.read(File.join(site.root_dir, "src/_partials/mailers/_#{slug.tr("-", "_")}.erb")).lines
  source = source.drop(1)
  source[0] = "#{open} u = uniform_mail -#{close}\n"
  code = source.join.strip.html_safe
-%>
```erb
<%= code %>
