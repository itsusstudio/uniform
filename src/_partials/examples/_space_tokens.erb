<%
  css = File.read(File.join(Studio::Uniform.assets_path, "uniform/tokens.css"))
  declarations = ->(block) { block.to_s.scan(/(--u-[a-z0-9-]+)\s*:\s*([^;]+);/).to_h { |name, value| [name, value.strip.gsub(/\s+/, " ")] } }
  root = declarations.(css[/^:root \{(.*?)^\}/m, 1])
  tablet = declarations.(css[/@media \(max-width: 1023px\) \{(.*?)^\}/m, 1])
  phone = declarations.(css[/@media \(max-width: 639px\) \{(.*?)^\}/m, 1])
  business = declarations.(css[/^\[data-u-audience="business"\] \{(.*?)^\}/m, 1])
  consumer = declarations.(css[/^\[data-u-audience="consumer"\] \{(.*?)^\}/m, 1])
  space = root.keys.select { |n| n.start_with?("--u-space-", "--u-grid-", "--u-page-", "--u-section-", "--u-width-", "--u-max-width-") }
  sizes = business.keys.select { |n| n.start_with?("--u-size-") }
-%>
<div class="u-stack u-gap-12">
<div class="u-table" tabindex="0" role="region" aria-label="Space tokens">
<table class="reference-tokens">
<thead><tr><th scope="col">Token</th><th scope="col">Phone</th><th scope="col">Tablet</th><th scope="col">Wide</th></tr></thead>
<tbody>
<% space.each do |name| -%>
<tr>
<%= render "token_name", token: name %>
<td><code class="u-text-data"><%= phone[name] || tablet[name] || root[name] %></code></td>
<td><code class="u-text-data"><%= tablet[name] || root[name] %></code></td>
<td><code class="u-text-data"><%= root[name] %></code></td>
</tr>
<% end -%>
</tbody>
</table>
</div>

<div class="u-table" tabindex="0" role="region" aria-label="Sizes by audience">
<table class="reference-tokens">
<thead><tr><th scope="col">Token</th><th scope="col">Business</th><th scope="col">Consumer</th></tr></thead>
<tbody>
<% sizes.each do |name| -%>
<tr>
<%= render "token_name", token: name %>
<td><code class="u-text-data"><%= business[name] %></code></td>
<td><code class="u-text-data"><%= consumer[name] %></code></td>
</tr>
<% end -%>
</tbody>
</table>
</div>
</div>
