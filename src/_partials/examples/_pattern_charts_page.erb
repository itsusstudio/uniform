<%# locals: (phone:) -%>
<% scope = phone ? "phone" : "desktop" -%>
<div class="u-container flex flex-col gap-12">
  <header class="u-page-header">
    <hgroup>
      <h1>Reports</h1>
      <p>November so far, to Thursday, <span class="u-data">Nov 12</span></p>
    </hgroup>
  </header>
  <div class="flex flex-col gap-6">
    <%= inline_partial("examples/pattern_charts_figures", prefix: scope, indent: 4) %>
<% if phone -%>
    <%= inline_partial("examples/chart_line", prefix: scope, indent: 4) %>
    <%= inline_partial("examples/chart_meter", indent: 4) %>
    <%= inline_partial("examples/chart_bar", prefix: scope, indent: 4) %>
    <%= inline_partial("examples/chart_stacked", indent: 4) %>
<% else -%>
    <div class="u-grid gap-6">
      <%= inline_partial("examples/chart_line", span: 8, prefix: scope, indent: 6) %>
      <div class="@grid:col-span-4 flex flex-col gap-6">
        <%= inline_partial("examples/chart_meter", indent: 8) %>
        <%= inline_partial("examples/chart_stacked", indent: 8) %>
      </div>
      <%= inline_partial("examples/chart_bar", span: 12, prefix: scope, indent: 6) %>
    </div>
<% end -%>
  </div>
</div>
