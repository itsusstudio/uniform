<%
  tokens = uniform_tokens
  root = tokens[:theme]
  consumer = tokens[:consumer]
  business = root
  px = ->(value) { value.to_s.gsub(/([\d.]+)rem/) { "#{($1.to_f * 16).round}px" } }
  resolve = ->(value) { (name = value.to_s[/\Avar\((--[a-z0-9-]+)\)\z/, 1]) ? px.(root[name]) : px.(value) }
  fonts = root.keys.select { |n| n.start_with?("--font-") }
  sizes = root.keys.select { |n| n.match?(/\A--text-\d00\z/) }
  roles = consumer.keys.select { |n| n.start_with?("--text-") }
-%>
<div class="flex flex-col gap-12">
<div class="u-table" tabindex="0" role="region" aria-label="Font tokens">
<table class="reference-tokens">
<thead><tr><th scope="col">Token</th><th scope="col">Face</th></tr></thead>
<tbody>
<% fonts.each do |name| -%>
<tr>
<%= render "token_name", token: name %>
<td><code class="u-data"><%= root[name].split(",").first.delete('"') %></code></td>
</tr>
<% end -%>
</tbody>
</table>
</div>

<div class="u-table" tabindex="0" role="region" aria-label="Type sizes">
<table class="reference-tokens">
<thead><tr><th scope="col">Size</th><th scope="col">Value</th><th scope="col">Line height</th></tr></thead>
<tbody>
<% sizes.each do |name| -%>
<% line = "#{name}--line-height" -%>
<tr>
<%= render "token_name", token: name %>
<td><code class="u-data"><%= px.(root[name]) %></code></td>
<td><code class="u-data"><%= root[line] %></code> <span class="u-meta"><%= line %></span></td>
</tr>
<% end -%>
<tr>
<%= render "token_name", token: "--leading-prose" %>
<td></td>
<td><code class="u-data"><%= root["--leading-prose"] %></code></td>
</tr>
</tbody>
</table>
</div>

<div class="u-table" tabindex="0" role="region" aria-label="Type roles by audience">
<table class="reference-tokens">
<thead><tr><th scope="col">Role</th><th scope="col">Business</th><th scope="col">Consumer</th></tr></thead>
<tbody>
<% roles.each do |name| -%>
<tr>
<%= render "token_name", token: name %>
<td><code class="u-data"><%= resolve.(business[name]) %></code></td>
<td><code class="u-data"><%= resolve.(consumer[name]) %></code></td>
</tr>
<% end -%>
</tbody>
</table>
</div>
</div>
