<%# locals: (metadata:, title:) -%>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<% resource_title = strip_html(strip_newlines(title.to_s)) %>
<title><% if resource_title.empty? || resource_title == metadata.title %><%= metadata.title %><% else %><%= resource_title %> · <%= metadata.title %><% end %></title>
<meta name="description" content="<%= metadata.description %>" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<script>try { const theme = localStorage.getItem("u-theme-preference"); if (theme === "light" || theme === "dark") document.documentElement.dataset.uTheme = theme } catch (error) {}</script>
<script>try { if (localStorage.getItem("uniform-audience") === "consumer") document.documentElement.dataset.uAudience = "consumer" } catch (error) {}</script>
<link rel="stylesheet" href="<%= asset_path :css %>" />
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>
