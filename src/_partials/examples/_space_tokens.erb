<%
  tokens = uniform_tokens
  root = tokens[:theme]
  tablet = tokens[:tablet]
  phone = tokens[:phone]
  consumer = tokens[:consumer]
  business = root
  sizes = consumer.keys.select { |n| n.start_with?("--spacing-") }
  space = root.keys.select { |n| (n.start_with?("--spacing") && !sizes.include?(n)) || n.start_with?("--container-") }
-%>
<div class="flex flex-col gap-12">
<div class="u-table" tabindex="0" role="region" aria-label="Space tokens">
<table class="reference-tokens">
<thead><tr><th scope="col">Token</th><th scope="col">Phone</th><th scope="col">Tablet</th><th scope="col">Wide</th></tr></thead>
<tbody>
<% space.each do |name| -%>
<tr>
<%= render "token_name", token: name %>
<td><code class="u-data"><%= phone[name] || tablet[name] || root[name] %></code></td>
<td><code class="u-data"><%= tablet[name] || root[name] %></code></td>
<td><code class="u-data"><%= root[name] %></code></td>
</tr>
<% end -%>
</tbody>
</table>
</div>

<div class="u-table" tabindex="0" role="region" aria-label="Sizes by audience">
<table class="reference-tokens">
<thead><tr><th scope="col">Token</th><th scope="col">Business</th><th scope="col">Consumer</th></tr></thead>
<tbody>
<% sizes.each do |name| -%>
<tr>
<%= render "token_name", token: name %>
<td><code class="u-data"><%= business[name] %></code></td>
<td><code class="u-data"><%= consumer[name] %></code></td>
</tr>
<% end -%>
</tbody>
</table>
</div>
</div>
