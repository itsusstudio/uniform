<%# locals: (format:) -%>
<% u = Studio::Uniform::Mail.for(format) -%>
<%= u.heading "Your week at the shop" %>
<%= u.paragraph "Kensington Jewellery Repair, Nov 6 to Nov 12." %>
<%= u.rows [
  ["Jobs in", "12", :mono],
  ["Ready", "5 ready for pickup", :success],
