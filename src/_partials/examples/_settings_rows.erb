<div class="u-settings">
  <h2>General</h2>
  <section class="u-setting">
    <div>
      <h3>Shop name</h3>
      <p>Customers see it on texts, emails and their pickup page.</p>
    </div>
    <div class="u-setting-edit">
      <p>Kensington Jewellery Repair</p>
      <button type="button" class="u-btn u-btn-ghost u-btn-icon" aria-label="Edit shop name"><%= raw render("icon", name: "pencil", small: true).strip %></button>
    </div>
  </section>
  <section class="u-setting">
    <div>
      <h3>Time zone</h3>
      <p>Due dates and reminders follow it.</p>
    </div>
    <select class="u-input" aria-label="Time zone"><option>(GMT-05:00) Toronto</option><option>(GMT-08:00) Vancouver</option></select>
  </section>
  <section class="u-setting">
    <div>
      <h3>Shop ID</h3>
      <p>Quote it when you speak with us.</p>
    </div>
    <div class="u-setting-value">
      <span class="u-data">KJR-48F2</span>
      <button type="button" class="u-btn u-btn-ghost">Copy</button>
    </div>
  </section>
  <section class="u-setting">
    <div>
      <h3>Logo</h3>
      <p>Shown at the top of tickets and the pickup page.</p>
    </div>
    <button type="button" class="u-btn u-btn-outline">Upload</button>
  </section>
  <hr>
  <h2>Notifications</h2>
  <section class="u-setting">
    <div>
      <h3>Text customers when a job is ready</h3>
      <p>Sent from the shop's number when you mark a job Ready for pickup.</p>
    </div>
    <label class="u-switch"><input type="checkbox" switch role="switch" aria-label="Text customers when a job is ready" checked></label>
  </section>
  <section class="u-setting">
    <div>
      <h3>Remind customers about pickups</h3>
      <p>A second text if a job is still waiting after 7 days.</p>
    </div>
    <label class="u-switch"><input type="checkbox" switch role="switch" aria-label="Remind customers about pickups"></label>
  </section>
  <hr>
  <h2>Delete shop</h2>
  <section class="u-setting">
    <div>
      <h3>Delete Kensington Jewellery Repair</h3>
      <p>Deletes every job, customer and photo. You can't undo this.</p>
    </div>
    <button type="button" class="u-btn u-btn-danger">Delete shop</button>
  </section>
</div>
