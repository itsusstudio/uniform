<%# locals: (navigation:, metadata:, current_url:) -%>
<u-sidebar id="site-nav" popover data-u-audience="business">
  <div>
    <a class="u-wordmark u-wordmark-lg u-wordmark-sans" href="<%= relative_url "/" %>">uniform</a>
    <span class="u-meta">v<%= metadata.version %></span>
  </div>
  <nav class="u-nav" aria-label="Uniform">
  <% navigation.each do |group| %>
    <% if group.url %>
      <a class="u-nav-link-section" href="<%= relative_url group.url %>"<% if group.url == current_url %> aria-current="page"<% end %>><%= group.label %></a>
    <% else %>
      <details<% if group.items.any? { |item| item.url == current_url } %> open<% end %>>
        <summary><%= group.label %></summary>
        <ul>
          <% group.items.each do |item| %>
            <li>
              <a href="<%= relative_url item.url %>"<% if item.url == current_url %> aria-current="page"<% end %>><%= item.title %></a>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  <% end %>
  </nav>
  <div class="site-nav-footer">
    <ul>
      <li>
        <button type="button" popovertarget="site-appearance"><%= inline_partial("icon", name: "monitor", small: true) %><span>Appearance</span></button>
        <div class="u-menu" id="site-appearance" popover>
          <u-theme-preference>
            <button type="button" value="system"><%= inline_partial("icon", name: "monitor", small: true) %>Use system setting</button>
            <button type="button" value="light"><%= inline_partial("icon", name: "sun", small: true) %>Light</button>
            <button type="button" value="dark"><%= inline_partial("icon", name: "moon", small: true) %>Dark</button>
          </u-theme-preference>
        </div>
      </li>
    </ul>
    <%= render "audience_switch", legend_class: "text-small" %>
  </div>
</u-sidebar>
