<%# locals: (id:, popover:, collapsed: false, current: "jobs") -%>
<% rail = defined?(collapsed) && collapsed -%>
<% here = (defined?(current) && current) || "jobs" -%>
<u-sidebar<% if popover %> id="<%= id %>" popover<% end %>>
  <div>
    <a class="u-wordmark u-wordmark-serif" href="/" data-monogram="W">Workbench</a>
    <button type="button" aria-label="Sidebar" aria-expanded="<%= !rail %>"></button>
  </div>
  <nav class="u-nav" aria-label="Workbench">
    <div>
      <ul>
        <li><a href="/"<% if here == "home" %> aria-current="page"<% end %>><%= raw render("icon", name: "house", small: true).strip %><span>Home</span></a></li>
        <li><a href="/jobs"<% if here == "jobs" %> aria-current="page"<% end %>><%= raw render("icon", name: "wrench", small: true).strip %><span>Jobs</span></a></li>
        <li><a href="/customers"<% if here == "customers" %> aria-current="page"<% end %>><%= raw render("icon", name: "users", small: true).strip %><span>Customers</span></a></li>
      </ul>
    </div>
    <div>
      <ul>
        <li><a href="/payments"<% if here == "payments" %> aria-current="page"<% end %>><%= raw render("icon", name: "credit-card", small: true).strip %><span>Payments</span></a></li>
      </ul>
    </div>
    <details<% if here == "reports" %> open<% end %>>
      <summary><%= raw render("icon", name: "chart-column", small: true).strip %><span>Reports</span></summary>
      <ul>
        <li><a href="/reports/turnaround"<% if here == "reports" %> aria-current="page"<% end %>>Turnaround</a></li>
        <li><a href="/reports/revenue">Revenue</a></li>
      </ul>
    </details>
  </nav>
  <div>
    <ul>
      <li><a href="/guides"><%= raw render("icon", name: "file", small: true).strip %><span>Guides</span></a></li>
      <li>
        <button type="button" popovertarget="<%= id %>-help"><%= raw render("icon", name: "circle-help", small: true).strip %><span>Help</span></button>
        <div class="u-menu" id="<%= id %>-help" popover>
          <a href="/help">Help centre</a>
          <a href="/changelog">What’s new</a>
          <a href="/help/contact">Speak with us</a>
        </div>
      </li>
    </ul>
    <button type="button" popovertarget="<%= id %>-account">
      <span aria-hidden="true">DW</span>
      <span><span>Dana Whitfield</span><small>dana@kensingtonrepair.ca</small></span>
    </button>
    <div class="u-menu" id="<%= id %>-account" popover>
      <details>
        <summary>Appearance</summary>
        <u-theme>
          <button type="button" value="system"><%= raw render("icon", name: "monitor", small: true).strip %>Use system setting</button>
          <button type="button" value="light"><%= raw render("icon", name: "sun", small: true).strip %>Light</button>
          <button type="button" value="dark"><%= raw render("icon", name: "moon", small: true).strip %>Dark</button>
        </u-theme>
      </details>
      <hr>
      <form action="/session" method="post">
        <input type="hidden" name="_method" value="delete">
        <button type="submit" class="u-menu-item-danger">Log out</button>
      </form>
    </div>
  </div>
</u-sidebar>
