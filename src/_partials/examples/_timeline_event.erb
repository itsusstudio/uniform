<%# locals: (event:) -%>
<li>
<% if event[:initials] -%>
  <span class="u-avatar u-avatar-sm" aria-hidden="true"><%= event[:initials] %></span>
<% end -%>
  <div>
<% if event[:author] -%>
    <strong><%= event[:author] %></strong>
<% end -%>
<% Array(event[:text]).map { |text| text.to_s.html_safe }.each do |line| -%>
    <p><%= line %></p>
<% end -%>
<% if event[:detail] -%>
<% detail = event[:detail].to_s.html_safe -%>
    <small><%= detail %></small>
<% end -%>
  </div>
  <u-relative-time format="time"><time datetime="<%= event[:at] %>"><%= event[:time] %></time></u-relative-time>
</li>
