<%# locals: (day:) -%>
<section class="flex flex-col gap-2">
  <h3 class="text-small font-medium<% if day[:mono] %> u-data<% end %>"><u-relative-time format="day"><time datetime="<%= day[:events].first[:at] %>"><%= day[:label] %></time></u-relative-time></h3>
  <ol class="u-timeline">
<% day[:events].each do |event| -%>
    <%= inline_partial("examples/timeline_event", event: event, indent: 4) %>
<% end -%>
  </ol>
</section>
