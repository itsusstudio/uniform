<% span_value = defined?(span) && span -%>
<% loading_value = defined?(loading) && loading -%>
<section class="u-card <%= grid_span(span_value) %>">
  <header>
    <h2>Finished on time</h2>
    <p class="text-small text-muted">This month</p>
  </header>
  <div class="u-card-content">
<% if loading_value -%>
    <div class="u-stat" aria-hidden="true">
      <p><span class="u-shimmer">31 of 40</span></p>
      <p><span class="u-shimmer">Jobs by their due date</span></p>
    </div>
    <u-chart type="meter" aria-busy="true" data-label="Jobs finished on time this month"></u-chart>
<% else -%>
    <div class="u-stat">
      <p>31 of 40</p>
      <p data-trend="up">Jobs by their due date, up from 26 of 38 in October</p>
    </div>
    <u-chart type="meter" data-label="Jobs finished on time this month">
      <script type="application/json">{"rows": [{"label": "On time", "values": [31]}, {"label": "Due", "values": [40]}]}</script>
    </u-chart>
<% end -%>
  </div>
</section>
