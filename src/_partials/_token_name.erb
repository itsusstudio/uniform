<%# locals: (token:) -%>
<th scope="row"><div class="flex flex-wrap items-center gap-1"><u-copy><button type="button" class="u-link-btn u-data reference-name" data-copy="<%= token %>" data-copied="Copied" data-copy-failed="Couldn’t copy"><%= token %></button></u-copy><% if (note = site.data.token_notes && site.data.token_notes[token]) %><span class="u-tooltip"><button type="button" class="u-btn u-btn-ghost u-btn-icon reference-info" aria-label="<%= token %>: <%= note %>"><%= inline_partial("icon", name: "info", small: true) %></button><span aria-hidden="true"><%= note %></span></span><% end %></div></th>
